# HomeLab OS Backend Configuration Variables

# 1. Execution Settings
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# 2. Security Configuration
# CRITICAL: This secret key is required when running in production mode.
# Generate a secure random string (e.g., using openssl rand -hex 32)
JWT_SECRET=your-32-character-random-jwt-secret-key-here

# CRITICAL: Required in production. Encrypts stored secrets (SMTP password, remote desktop
# password) at rest. Generate a unique value (e.g., openssl rand -hex 32) and keep it stable:
# changing it makes previously encrypted secrets unreadable until they are entered again.
ENCRYPTION_KEY=your-32-character-random-encryption-key-here

# Set when the dashboard runs behind a reverse proxy or tunnel (Cloudflare Tunnel, nginx, Traefik)
# so per-IP rate limiting sees the real client address. Accepts "true", a hop count such as 1,
# or a comma-separated list of proxy IPs/CIDRs. Leave unset when clients connect directly.
# TRUST_PROXY=1

# Hours a session may last in total, however active, before signing in again (default 12).
# SESSION_MAX_HOURS=12

# Sites allowed to embed the dashboard in a frame. Defaults to none. Use CSP source syntax, e.g.:
# FRAME_ANCESTORS='self' https://home.example.com

# Opt-in escape hatch for SMTP relays with self-signed certificates or without STARTTLS.
# Disables certificate validation and allows cleartext credentials. Leave unset otherwise.
# SMTP_ALLOW_INSECURE=true

# 3. Infrastructure Integrations
# Docker Socket Proxy TCP bridge endpoint URL
DOCKER_PROXY_URL=http://docker-proxy:2375
